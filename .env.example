# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# API AUTHENTICATION (REQUIRED FOR SECURITY)
# ==========================================
# IMPORTANT: Set REQUIRE_AUTH=true for production
# Generate secure token: openssl rand -hex 32
REQUIRE_AUTH=true
# API_TOKEN is required when REQUIRE_AUTH=true
API_TOKEN=your-secret-api-token-here-change-this

# ==========================================
# CORS CONFIGURATION
# ==========================================
# For production, set specific domain (e.g., https://yourdomain.com)
# CORS_ORIGIN=* in production requires ALLOW_WILDCARD_CORS=true
CORS_ORIGIN=https://yourdomain.com

# ==========================================
# TRUST PROXY CONFIGURATION
# ==========================================
# Default for Dokploy behind a single trusted reverse proxy
TRUST_PROXY=1

# ==========================================
# OPTIONAL SECURITY OVERRIDES
# ==========================================
# Set to true only if you intentionally allow every browser origin in production
ALLOW_WILDCARD_CORS=false

# Set to true only if your deployment intentionally serves http: images in production
ALLOW_HTTP_IMAGES=false

# ==========================================
# WATERMARK CONFIGURATION (OPTIONAL)
# ==========================================
# Default address shown on watermark if not provided in request
WATERMARK_ADDRESS=Jakarta, Indonesia

# ==========================================
# FONT CONFIGURATION (OPTIONAL)
# ==========================================
# Bundle custom fonts in public/fonts/ for consistent rendering on Vercel/cloud.
# If not set, the service falls back to system fonts (works in Docker).
# Supported formats: TTF, OTF, WOFF, WOFF2.
# Example (Inter font from public/fonts/):
# WATERMARK_FONT_REGULAR=public/fonts/Inter-Regular.ttf
# WATERMARK_FONT_SEMIBOLD=public/fonts/Inter-SemiBold.ttf
