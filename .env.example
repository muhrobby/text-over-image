# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# API AUTHENTICATION (REQUIRED FOR SECURITY)
# ==========================================
# IMPORTANT: Set REQUIRE_AUTH=true for production
# Generate secure token: openssl rand -hex 32
REQUIRE_AUTH=true
API_TOKEN=your-secret-api-token-here-change-this

# ==========================================
# CORS CONFIGURATION
# ==========================================
# For production, set specific domain (e.g., https://yourdomain.com)
# For development, use * to allow all origins
CORS_ORIGIN=*

# ==========================================
# WATERMARK CONFIGURATION (OPTIONAL)
# ==========================================
# Default address shown on watermark if not provided in request
WATERMARK_ADDRESS=Jakarta, Indonesia